<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="view_payroll_distribution_process_wiz_form" model="ir.ui.view">
            <field name="name">Payroll Distribution Process</field>
            <field name="model">payroll.distribution.process.wiz</field>
            <field name="arch" type="xml">
                <form string="Payroll Distribution">
                    <p class="oe_grey">
                        Wizard for the execution of a process that reads an Excel file and makes a series of calculations to
                        finish updating the percentages of the analytical account of the analytical label of the parameterization
                    </p>
                    <group>
                        <field name="file_name" readonly="1" nolabel="1" />
                        <field name="upload_file" filename="file_name" nolabel="1" />
                    </group>
                    <footer>
                        <button name="check_data" string="Check Data" type="object" class="btn-primary" />
                        <button name="update_distribution" string="Update Process" type="object" class="btn-primary" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />

                        <button name="update_distribution_detail" string="Actualizar reparto y obtener detalle" type="object" class="btn-primary" />
                    </footer>
                </form>
            </field>
        </record>


        <record id="action_view_payroll_distribution_process_wiz" model="ir.actions.act_window">
            <field name="name">Payroll Distribution Process</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">payroll.distribution.process.wiz</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_payroll_distribution" name="Payroll Distribution" parent="hr.menu_hr_root" sequence="91" />
        <menuitem id="menu_payroll_distribution_process" parent="reparto_nomina.menu_payroll_distribution" action="action_view_payroll_distribution_process_wiz" sequence="90" />
</odoo>
