<odoo>

    <record id="res_config_settings_view_form_inherit_reparto_nomina" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.employee.id.inherit.reparto.nomina</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']/block[@name='employees_setting_container']" position="inside">
                <setting id="employee_account_analytic_tag_setting" help="Etiqueta para el reparto analítico de nóminas.">
                    <field name="employee_account_analytic_tag_id" class="o_light_label" can_create="true" can_write="true" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
