<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="lotadditional_stock_view_picking_form" model="ir.ui.view">
        <field name="name">lotadditional_stock.view_picking_form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids_without_package']//field[@name='lot_ids']"
                position="after"
            >
                <button
                    name="action_barcode_wizard"
                    context="{'lot_mode': 'inline'}"
                    type="object"
                    icon="fa-qrcode"
                    title="Scan QR codes"
                    invisible="not show_details_visible or has_tracking != 'serial'"
                    options='{"warn": true}'
                />
                <button
                    name="action_barcode_wizard"
                    context="{'lot_mode': 'new'}"
                    type="object"
                    icon="fa-barcode"
                    title="Scan barcodes in new window"
                    invisible="not show_details_visible or has_tracking != 'serial'"
                    options='{"warn": true}'
                />
            </xpath>
        </field>
    </record>
</odoo>
